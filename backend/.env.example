# Copy to .env and fill in what you need. Everything here is OPTIONAL —
# the core training/testing loop works fully offline without any of these.
#
# Docker Compose loads this file automatically if present
# (docker compose up --build -d). Restart the backend after edits:
#   docker compose up -d --force-recreate backend

# Hugging Face token (publish/import + private repos)
# SLMKIT_HF_TOKEN=hf_xxx

# Optional LLM-as-judge for the Eval Lab
# SLMKIT_JUDGE_PROVIDER=anthropic
# SLMKIT_JUDGE_API_KEY=sk-ant-xxx
# SLMKIT_JUDGE_MODEL=claude-sonnet-5

# Override where SLM Kit stores its data
# Native default: ~/.slmkit
# Docker Compose already sets this to /data/slmkit (volume slmkit-data)
# SLMKIT_HOME=/home/you/.slmkit

# llmfit binary name/path (default: llmfit on PATH; falls back to internal estimator)
# SLMKIT_LLMFIT_BIN=llmfit

# API server
# SLMKIT_HOST=127.0.0.1
# SLMKIT_PORT=8000

# Managed local OpenAI-compatible model server
# SLMKIT_DEPLOY_HOST=127.0.0.1
# SLMKIT_DEPLOY_PORT=8802
# SLMKIT_DEPLOY_STARTUP_TIMEOUT_SECONDS=180

# Only enable for Hugging Face repositories whose custom code you trust
# SLMKIT_TRUST_REMOTE_CODE=false

# Dataset upload guard (uploads are streamed rather than buffered in RAM)
# SLMKIT_MAX_UPLOAD_MB=512
